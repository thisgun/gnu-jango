staticfiles/

# Keep the Django theme copy of the Next.js static export.
/.g5-next-theme-build-*/
# Local SQLite clones and screenshots used by the Next.js theme runtime checks.
/.tmp-nextjs-runtime/
/nextjs/.tmp-nextjs-runtime/
!gnu_jango/templates/theme_static/
!gnu_jango/templates/theme_static/nextjs25/
!gnu_jango/templates/theme_static/nextjs25/_next/
!gnu_jango/templates/theme_static/nextjs25/_next/static/
!gnu_jango/templates/theme_static/nextjs25/_next/static/**
!gnu_jango/templates/theme_static/nextjs25/assets/
!gnu_jango/templates/theme_static/nextjs25/assets/**
!gnu_jango/templates/theme_static/nextjs_default/
!gnu_jango/templates/theme_static/nextjs_default/_next/
!gnu_jango/templates/theme_static/nextjs_default/_next/static/
!gnu_jango/templates/theme_static/nextjs_default/_next/static/**
!gnu_jango/templates/theme_static/nextjs_default/assets/
!gnu_jango/templates/theme_static/nextjs_default/assets/**
# Every Next.js theme export keeps its hashed assets (a theme added later, such as handbook, needs no
# line of its own; without these the "static/" rule above silently leaves its CSS and JS out of git).
!gnu_jango/templates/theme_static/*/
!gnu_jango/templates/theme_static/*/_next/
!gnu_jango/templates/theme_static/*/_next/static/
!gnu_jango/templates/theme_static/*/_next/static/**
!gnu_jango/templates/theme_static/*/assets/
!gnu_jango/templates/theme_static/*/assets/**

settings.json
.prettierignore
.unibeautifyrc.json
test/

# End of https://www.toptal.com/developers/gitignore/api/django

# Deployment env templates (placeholders only). The ENV/ pattern above matches deploy/env/ on
# case-insensitive filesystems (Windows, macOS), so re-include it explicitly.
!deploy/env/

# Local Vercel project linkage can contain account and project metadata.
/.vercel/
# Serena's per-worktree onboarding memory is local development state.
/.serena/
# Temporary git worktrees created inside the checkout (e.g. .wt-docs-ask); `git add -A` must not pick them up.
/.wt-*/
# `vercel env pull` / `vercel link` write tokens (VERCEL_OIDC_TOKEN) and env values here.
.env*.local
/nextjs/.env.production
# Local scheduler and task monitor state (may contain operational metadata).
celerybeat-schedule*
flower.db*
/runtime/
