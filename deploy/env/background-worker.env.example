# External worker runtime only. Copy OUTSIDE the repository, chmod 600, replace placeholders.
# Loaded as raw KEY=value by docker-compose.background.yml (Compose >= 2.30).
# Do not wrap values in quotes or use ${VAR} interpolation in this file.
# One file per site: never combine demo and handbook credentials.

SECRET_KEY=<the exact existing web SECRET_KEY; do not generate a different key>
ALLOWED_HOSTS=<existing-site.vercel.app>
DATABASE_URL=postgresql://<same-site-user>:<password>@<same-site-pooler>:6543/<database>?sslmode=require
DB_SSL_REQUIRE=True
DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=True

# The web site and worker need the same shared cache. Use its existing value.
# Database cache requires `createcachetable` to have been applied already.
CACHE_URL=db://
# Internal Redis for this Compose project; no public Redis port is needed.
# Web requests in background mode write the outbox to DB, not directly to this broker.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Exact same bucket, prefix and public URL as this site's web deployment.
S3_BUCKET=<existing-site-bucket>
S3_REGION=<existing-region>
S3_ACCESS_KEY_ID=<existing-site-access-key>
S3_SECRET_ACCESS_KEY=<existing-site-secret-key>
S3_ENDPOINT_URL=https://<existing-project>.storage.supabase.co/storage/v1/s3
S3_PUBLIC_BASE_URL=https://<existing-project>.supabase.co/storage/v1/object/public/<bucket>
S3_ADDRESSING_STYLE=path
S3_LOCATION=

# Keep these identical to the web deployment, including intentionally disabled services.
# Console output is suitable only for synthetic demo messages. Use SMTP for real recipients.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=<same-web-from-address>
SERVER_EMAIL=<same-web-server-address>

# Enable only the providers used on this site, with its existing settings.
G5_SMS_PROVIDER=disabled
G5_ICODE_TOKEN_KEY=
G5_ICODE_JSON_SERVER=211.172.232.124
G5_ICODE_JSON_PORT=9201
G5_ICODE_ID=
G5_ICODE_PASSWORD=
G5_ICODE_SERVER=
G5_ICODE_PORT=7295
G5_SMS_RECIPIENT_HOURLY_LIMIT=5
G5_SMS_HOURLY_LIMIT=300
G5_SMS_BREAKER_SECONDS=300
SHOP_TOSS_CLIENT_KEY=
SHOP_TOSS_SECRET_KEY=
SHOP_TOSS_VBANK_ENABLED=False
SHOP_TOSS_ADMIN_KEYS_ENABLED=True
SHOP_TOSS_API_BASE_URL=https://api.tosspayments.com
SHOP_PAYMENT_CALLBACK_SECRET=
SHOP_PAYMENT_CALLBACK_SIGNATURE_SECRET=
SHOP_PAYMENT_PROVIDER=
SHOP_PAYMENT_ADAPTER_BASE_URL=
SHOP_PAYMENT_ADAPTER_SECRET=

# Optional monitoring. Choose a separate port per site in the host shell, e.g. FLOWER_PORT=5556.
FLOWER_BASIC_AUTH=
