# Profile 2 -- VPS (production): Docker compose or gunicorn + nginx, local media, system cron.
# Copy to the project root as `.env` (python-decouple reads it) or export the variables in the
# service unit / compose environment. Placeholders only: replace every <...> value.
# Guide: docs/04-deploy/deployment-profiles.md

DEPLOY_PROFILE=vps
ENVIRONMENT=Production
DJANGO_SETTINGS_MODULE=example.settings.production
DEBUG=False
SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())">
ALLOWED_HOSTS=<example.com>,<www.example.com>

# HTTPS is terminated by nginx (or another proxy) that sets X-Forwarded-Proto.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
TRUSTED_PROXY_COUNT=1

# Database -- Postgres (recommended) ...
DATABASE_URL=postgresql://<user>:<password>@<db-host>:5432/<dbname>
# A Postgres on the same host/compose network without TLS:
DB_SSL_REQUIRE=False
DB_CONN_MAX_AGE=600
# ... or SQLite for one small server (keep the file on a persistent, backed-up disk):
# DATABASE_URL=sqlite:////srv/gnu_jango/data/db.sqlite3

# Uploads stay on local disk; serve MEDIA_ROOT from nginx at /media/.
MEDIA_STORAGE=local
MEDIA_ROOT=/srv/gnu_jango/media

# Several gunicorn workers need a shared cache (throttles, cooldowns, menu cache invalidation).
# Compose ships a redis service; without redis use CACHE_URL=db:// and run `manage.py createcachetable`.
CACHE_URL=redis://<redis-host>:6379/1
GUNICORN_WORKERS=3

# Scheduled jobs run from system cron: `python manage.py run_scheduled_jobs`.
# CRON_SECRET is only needed if an HTTP scheduler should call /api/internal/cron instead.
CRON_SECRET=

LOG_TO_FILE=False
CELERY_BROKER_URL=redis://<redis-host>:6379/0
CELERY_RESULT_BACKEND=redis://<redis-host>:6379/0
CELERY_TASK_ALWAYS_EAGER=False

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp.example.com>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=<webmaster@example.com>
