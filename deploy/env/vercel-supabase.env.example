# Profile 1 -- Vercel + Supabase (free demo): Django as one Vercel Python function, Supabase Postgres,
# uploads in Supabase Storage (S3 protocol), cache in the database, Vercel Cron -> /api/internal/cron.
# Enter these in Vercel > Project > Settings > Environment Variables (Production, and Preview if used).
# Do not commit filled-in values. Placeholders only: replace every <...> value.
# Guide: docs/04-deploy/deployment-profiles.md

DEPLOY_PROFILE=vercel
# example/settings/__init__.py loads the production settings when ENVIRONMENT=Production.
ENVIRONMENT=Production
DEBUG=False
SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())">
# *.vercel.app deployment hosts are added automatically (VERCEL=1); list custom domains here.
ALLOWED_HOSTS=<your-app.example.com>
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
TRUSTED_PROXY_COUNT=1

# Supabase > Connect > "Transaction pooler" (Supavisor, IPv4, port 6543). Serverless functions open
# many short-lived connections, so: no persistent connections, no server-side cursors, TLS required.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@<pooler-host>:6543/postgres?sslmode=require
DB_CONN_MAX_AGE=0
DB_DISABLE_SERVER_SIDE_CURSORS=True
DB_SSL_REQUIRE=True

# Supabase > Storage > S3 Configuration (enable the S3 protocol, create an access key).
MEDIA_STORAGE=s3
S3_BUCKET=<bucket-name>
S3_ENDPOINT_URL=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
S3_ACCESS_KEY_ID=<s3-access-key-id>
S3_SECRET_ACCESS_KEY=<s3-secret-access-key>
# Public bucket: plain, cacheable URLs. Leave empty for a private bucket (signed, expiring URLs).
S3_PUBLIC_BASE_URL=https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
S3_LOCATION=
# boto3 >= 1.36 adds CRC checksums to every upload by default, which some S3-compatible services
# reject; botocore reads these two variables and only sends checksums when an operation requires one.
AWS_REQUEST_CHECKSUM_CALCULATION=when_required
AWS_RESPONSE_CHECKSUM_VALIDATION=when_required

# The function filesystem is read-only and every instance has its own memory: share the cache via
# Postgres (run `python manage.py createcachetable` once against DATABASE_URL).
CACHE_URL=db://
LOG_TO_FILE=False
# Optional audit-history retention. 0 keeps every revision; a positive value makes the daily
# scheduled jobs purge rows older than that many days.
AUDIT_RETENTION_DAYS=0

# Vercel Cron sends `Authorization: Bearer <CRON_SECRET>`. At least 16 random characters
# (e.g. `openssl rand -hex 32`).
CRON_SECRET=<random-secret>

# No Celery worker on Vercel: run tasks inside the request.
CELERY_TASK_ALWAYS_EAGER=True

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=<smtp.example.com>
EMAIL_PORT=587
EMAIL_HOST_USER=<smtp-user>
EMAIL_HOST_PASSWORD=<smtp-password>
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=<webmaster@example.com>

# Optional -- start a site on another theme with its own empty database (see docs/04-deploy/handbook-demo.md).
# They are only the defaults of cf_theme / cf_docs_group; a value saved in admin still wins.
# G5_DEFAULT_THEME=handbook
# G5_DEFAULT_DOCS_GROUP=manual

# Public popular terms are opt-in. Never automatically add visitors' questions here.
# G5_SEARCH_PUBLIC_KEYWORDS=배송비,회원가입,테마
G5_SEARCH_PUBLIC_MIN_COUNT=5
