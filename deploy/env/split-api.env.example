# Profile 3 -- Split: Next.js front-end on Vercel (separate Vercel project rooted at nextjs/),
# Django API on a VPS. This file is the API side; it extends deploy/env/vps.env.example.
# Front-end variables: nextjs/.env.production.local.example and nextjs/README.md
# ("Cross-Domain Authentication"). Placeholders only: replace every <...> value.
# Guide: docs/04-deploy/deployment-profiles.md

DEPLOY_PROFILE=split
ENVIRONMENT=Production
DJANGO_SETTINGS_MODULE=example.settings.production
DEBUG=False
SECRET_KEY=<generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())">
ALLOWED_HOSTS=<api.example.com>
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
TRUSTED_PROXY_COUNT=1

DATABASE_URL=postgresql://<user>:<password>@<db-host>:5432/<dbname>
DB_SSL_REQUIRE=False
MEDIA_STORAGE=local
MEDIA_ROOT=/srv/gnu_jango/media
CACHE_URL=redis://<redis-host>:6379/1
GUNICORN_WORKERS=3
LOG_TO_FILE=False

# --- Cross-domain auth ---------------------------------------------------------------------------
# proxy (recommended): the browser only talks to the front-end, which forwards /api/v1 server-side.
#   Front-end: G5_NEXT_RUNTIME=server, G5_API_INTERNAL_URL=https://<api.example.com>/api/v1,
#   NEXT_PUBLIC_API_URL unset. No CORS needed on the API.
SPLIT_AUTH_MODE=proxy
CORS_ALLOWED_ORIGINS=
CORS_ALLOW_CREDENTIALS=False

# direct: the browser calls the API host itself. Then set instead:
# SPLIT_AUTH_MODE=direct
# CORS_ALLOWED_ORIGINS=https://<your-vercel-app.example.com>
# CORS_ALLOW_CREDENTIALS=True
# CSRF_TRUSTED_ORIGINS=https://<your-vercel-app.example.com>
# (the g5_refresh cookie is SameSite=Lax, so sessions do not survive a reload across sites)

# Social login / identity verification return to the front-end origin.
SOCIAL_APP_BASE_URL=https://<your-vercel-app.example.com>
SOCIAL_ALLOWED_REDIRECT_ORIGINS=https://<your-vercel-app.example.com>

# Scheduled jobs: system cron on the VPS -> `python manage.py run_scheduled_jobs`.
CRON_SECRET=
