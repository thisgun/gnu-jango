## 사용시 반드시 아래 환경변수 앞에 있는 # 주석을 지우고 사용해 주세요.
## 앞에 ## 이렇게 두개 붙어있는것은 설명문이니 지우지 마세요.
## .env 파일로 있어야 적용이 됩니다. .env.example 파일을 복사하여 복사한 파일의 이름을 .env 로 바꿔 주세요.

# ENVIRONMENT=Development
# DEBUG=True
# SECRET_KEY=alksdjik3j4@&aksih%$%!!21ksadls982aslkj8982@aaasb

# ALLOWED_HOSTS=localhost,127.0.0.1

# CORS_ALLOW_ALL_ORIGINS=False
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# Do not combine CORS_ALLOW_ALL_ORIGINS=True with CORS_ALLOW_CREDENTIALS=True.
# CORS_ALLOW_CREDENTIALS=True

## Production-only security configs
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=False
# RECAPTCHA_PUBLIC_KEY=
# RECAPTCHA_PRIVATE_KEY=
# SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_PROFILES_SAMPLE_RATE=0.0
# SENTRY_SEND_DEFAULT_PII=False

## Logging configs
# LOG_LEVEL=INFO
# DJANGO_REQUEST_LOG_LEVEL=WARNING
# DJANGO_DB_LOG_LEVEL=WARNING
# LOG_TO_FILE=False
# LOG_FILE_PATH=logs/django.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5

## Database configs
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=
# DB_HOSTNAME=
# DB_PORT=5432

## Email configs
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=webmaster@example.com
# SERVER_EMAIL=server@example.com

## Background worker configs
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
# CELERY_TASK_ALWAYS_EAGER=False
# CELERY_TASK_EAGER_PROPAGATES=False
# CELERY_TASK_TIME_LIMIT=1800
# CELERY_TASK_SOFT_TIME_LIMIT=1500
# Opt in only after migrating and starting worker + media-worker + ONE Beat.
# In this mode mail/SMS/webhooks/conversions are DB-queued; eager execution is disabled.
# BACKGROUND_JOBS_ENABLED=True
# Optional monitoring service (localhost:5555). Never commit real credentials.
# FLOWER_BASIC_AUTH=

## NICEPAY authentication payment (MID + MerchantKey + AuthToken)
# Test and live pairs are separate; the server environment wins over the admin shop settings.
# SHOP_NICEPAY_TEST_MID=
# SHOP_NICEPAY_TEST_MERCHANT_KEY=
# SHOP_NICEPAY_MID=
# SHOP_NICEPAY_MERCHANT_KEY=
# SHOP_PAYMENT_PROVIDER=nicepay
# SHOP_NICEPAY_VBANK_ENABLED=True
# SHOP_NICEPAY_RETURN_URL=https://shop.example.com/api/v1/shop/payment/nicepay/return
# SHOP_NICEPAY_SUCCESS_URL=https://shop.example.com/shop/payment/success
# SHOP_NICEPAY_VBANK_NOTIFY_ALLOWED_IPS=

## Cloudinary configs
# CLOUDINARY_CLOUD_NAME =
# CLOUDINARY_API_SECRET =
# CLOUDINARY_API_KEY =

## Gnuboard5 asset source roots
## Add backup data roots separated by comma or pipe when the primary source does
## not contain historical data/file and data/item uploads.
# LEGACY_GNUBOARD5_SOURCE_ROOTS=C:\xampp824\www\gnuboard5_3
## Example with an additional backup source:
# LEGACY_GNUBOARD5_SOURCE_ROOTS=C:\xampp824\www\gnuboard5_3,C:\xampp824\www\gnuboard55
# Base URL for legacy public files such as /data/banner/{bn_id}.
# Set this to the original Gnuboard host when Django runs on a separate origin.
# LEGACY_GNUBOARD5_BASE_URL=http://127.0.0.9

## Admin analytics privacy
# ADMIN_VISIT_LOG_RETENTION_DAYS=180
# ADMIN_VISIT_LOG_MASK_IP=True
# ADMIN_VISIT_LOG_EXCLUDE_BOTS=True

## Payment and settlement production readiness
# SHOP_PAYMENT_CALLBACK_SECRET=
# SHOP_PAYMENT_CALLBACK_SIGNATURE_SECRET=
# Either Toss key set here wins over the pair saved (sealed) in admin > shop settings;
# leave both empty to use the admin keys. SHOP_TOSS_ADMIN_KEYS_ENABLED=False ignores the admin pair.
# SHOP_TOSS_CLIENT_KEY=
# SHOP_TOSS_SECRET_KEY=
# SHOP_TOSS_ADMIN_KEYS_ENABLED=True
# SHOP_TOSS_API_BASE_URL=https://api.tosspayments.com
# Register https://<host>/api/v1/shop/payment/toss/vbank/webhook for DEPOSIT_CALLBACK before enabling this.
# SHOP_TOSS_VBANK_ENABLED=False
# SHOP_PAYMENT_PROVIDER=
# SHOP_PAYMENT_ADAPTER_BASE_URL=
# SHOP_PAYMENT_ADAPTER_SECRET=
# SHOP_PAYMENT_ADAPTER_PROVIDERS=kcp,kcp_v2,inicis,nicepay,naverpay,kakaopay,samsungpay
# SHOP_PAYMENT_ADAPTER_TIMEOUT=10

## iCode SMS gateway (keep live credentials in the untracked .env file, never in admin settings)
# Token ("JSON") API: the token from iCode's 토큰키관리 page. Sends SMS and LMS.
# G5_ICODE_TOKEN_KEY=
# G5_ICODE_JSON_SERVER=211.172.232.124
# G5_ICODE_JSON_PORT=9201
# Empty or icode lets iCode send; disabled stops every text on this server (previews, staging).
# WARNING: staging servers and any copy of production data MUST set G5_SMS_PROVIDER=disabled.
# migrate_gnuboard5 imports cf_sms_use (SMS on) from production; with iCode credentials present,
# test orders, status changes and invoice uploads would text real customers.
# G5_SMS_PROVIDER=icode
# Send limits: texts per number per hour (admin phone exempt), per site per hour, and the pause
# after an iCode timeout. 0 turns a limit off.
# G5_SMS_RECIPIENT_HOURLY_LIMIT=5
# G5_SMS_HOURLY_LIMIT=300
# G5_SMS_BREAKER_SECONDS=300
# Legacy ID/password socket API (SMS only), used only when G5_ICODE_TOKEN_KEY is empty.
# G5_ICODE_ID=
# G5_ICODE_PASSWORD=
# G5_ICODE_SERVER=
# G5_ICODE_PORT=7295

## Hosted frontend and social login origins
# SOCIAL_APP_BASE_URL=https://your-vercel-app.example.com
# SOCIAL_ALLOWED_REDIRECT_ORIGINS=https://your-vercel-app.example.com
# Native app deep-link schemes (the app must send client_challenge / client_verifier)
# SOCIAL_ALLOWED_REDIRECT_SCHEMES=dday-app
# SOCIAL_NAVER_CLIENT_ID=
# SOCIAL_NAVER_CLIENT_SECRET=
# SOCIAL_KAKAO_REST_KEY=
# SOCIAL_KAKAO_CLIENT_SECRET=
# SOCIAL_GOOGLE_CLIENT_ID=
# SOCIAL_GOOGLE_CLIENT_SECRET=
# SOCIAL_FACEBOOK_APP_ID=
# SOCIAL_FACEBOOK_APP_SECRET=
# SOCIAL_TWITTER_CLIENT_ID=
# SOCIAL_TWITTER_CLIENT_SECRET=
# SOCIAL_PAYCO_CLIENT_ID=
# SOCIAL_PAYCO_CLIENT_SECRET=
# SOCIAL_PAYCO_SERVICE_PROVIDER_CODE=FRIENDS

## Gnuboard5 identity verification bridge
# GNUBOARD_CERT_USE=
# GNUBOARD_CERT_FIND=
# GNUBOARD_CERT_REQUIRED=
# GNUBOARD_CERT_SIMPLE=
# GNUBOARD_CERT_HP=
# GNUBOARD_CERT_IPIN=
# GNUBOARD_CERT_APP_BASE_URL=https://your-vercel-app.example.com
# GNUBOARD_CERT_ALLOWED_ORIGINS=https://your-vercel-app.example.com
# GNUBOARD_CERT_ADAPTER_BASE_URL=

## Deployment profile switches (docs/04-deploy/deployment-profiles.md, templates in deploy/env/)
## vps | vercel | split -> checked by `python manage.py check_deploy_profile`
# DEPLOY_PROFILE=vps
## DATABASE_URL wins over DB_*. DB_CONN_MAX_AGE defaults to 0 (development) / 600 (production);
## DB_SSL_REQUIRE to False (development) / True for Postgres (production). Behind a transaction
## pooler (Supabase :6543, PgBouncer) set DB_CONN_MAX_AGE=0 and DB_DISABLE_SERVER_SIDE_CURSORS=True.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# DB_CONN_MAX_AGE=0
# DB_SSL_REQUIRE=True
# DB_DISABLE_SERVER_SIDE_CURSORS=False
## Uploads: MEDIA_STORAGE=local (MEDIA_ROOT, default <project>/media) or s3 (needs django-storages[s3]).
# MEDIA_ROOT=
# MEDIA_STORAGE=local
## Supabase endpoint: https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_BUCKET=
# S3_ENDPOINT_URL=
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
## Optional key prefix, and the public bucket URL (unset = private bucket, signed URLs).
# S3_LOCATION=
# S3_PUBLIC_BASE_URL=
# S3_CUSTOM_DOMAIN=
## Cache: empty/locmem:// (per process) | db:// (then `manage.py createcachetable`) | redis://... | dummy://
# CACHE_URL=
# CACHE_KEY_PREFIX=
## Enables GET/POST /api/internal/cron with `Authorization: Bearer <CRON_SECRET>` (empty = 404).
# CRON_SECRET=
## Front-end origins allowed to POST with the CSRF cookie (split profile, direct mode).
# CSRF_TRUSTED_ORIGINS=
