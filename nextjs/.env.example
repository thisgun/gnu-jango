# Django/DRF API URL exposed to Next.js server components.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api/v1

# Internal API URL used by the Next.js /api/g5 proxy.
# On Vercel, set this to a public HTTPS API URL that Vercel can reach.
G5_API_INTERNAL_URL=http://127.0.0.1:8000/api/v1

# Django site URL for assets and cross-links.
NEXT_PUBLIC_G5_URL=http://127.0.0.1:8000

# Public Next.js app URL used for metadata and RSS links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Login provider. Keep g5-jwt for static theme/Vercel deployments.
# authjs is reserved for future server-runtime deployments.
NEXT_PUBLIC_AUTH_MODE=g5-jwt

# Comma-separated board IDs rendered as gallery boards.
NEXT_PUBLIC_GALLERY_BOARDS=n_gallery,gallery
